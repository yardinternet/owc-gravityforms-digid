#: src/DigiD/DigiD/Claim/StatusCodes/AuthnFailed.php:16
#, php-format
msgid ""
"An error has occurred in the communication with DigiD. Please try again "
"later. If this error persists, please check the website %s for the latest "
"information."
msgstr ""
"Er is een fout opgetreden in de communicatie met DigiD. Probeert u het later "
"nogmaals. Indien deze fout blijft aanhouden, kijk dan op de website %s voor "
"de laatste informatie."

#: src/DigiD/DigiD/Claim/StatusCodes/RequestDenied.php:16
msgid "Access denied"
msgstr "Toegang geweigerd"

#: src/DigiD/DigiD/Claim/StatusCodes/Requester.php:16
#: src/DigiD/DigiD/Claim/StatusCodes/Responder.php:16
msgid "Unknown error"
msgstr "Onbekende fout"

#: src/DigiD/DigiD/DigiDController.php:31
msgid "Something gone wrong"
msgstr "Er is een fout onstaan"

