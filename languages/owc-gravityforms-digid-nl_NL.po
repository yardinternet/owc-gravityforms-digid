#: resources/views/digid/no-certificates.php:2
#: src/DigiD/GravityFormsAddon.php:218
msgid "No certificate selected"
msgstr "Geen certificaat geselecteerd"

#: src/DigiD/Claim/StatusCodes/AuthnFailed.php:17
msgid "Login cancelled"
msgstr "Login geannuleerd"

#: src/DigiD/Claim/StatusCodes/RequestDenied.php:16
#: src/DigiD/Claim/StatusCodes/Requester.php:16
#: src/DigiD/Claim/StatusCodes/Responder.php:16
msgid ""
"Logging in to this organization failed. Please try again later. If you're "
"still unable to log in, sign in to My DigiD. This will allow you to verify "
"if your DigiD is working properly. There might be an issue with the "
"organization where you are trying to log in."
msgstr ""
"Inloggen bij deze organisatie is niet gelukt. Probeert u het later nog een "
"keer. Lukt het nog steeds niet? Log in bij Mijn DigiD. Zo controleert u of "
"uw DigiD goed werkt. Mogelijk is er een storing bij de organisatie waar u "
"inlogt."

#: src/DigiD/DigiDController.php:58 src/DigiD/DigiDController.php:65
msgid "Something went wrong. Please try again."
msgstr "Er is iets misgegaan. Probeer het nog eens."

