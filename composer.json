{
  "name": "plugin/owc-gravityforms-digid",
  "description": "Add a DigiD address field to GravityForms.",
  "homepage": "https://www.yard.nl",
  "type": "wordpress-plugin",
  "require": {
    "php": ">=7.0",
    "lightsaml/lightsaml": "^1.4",
    "wizkunde/samlbase": "^1.3",
    "php-di/php-di": "^6.0",
    "ocramius/proxy-manager": "^2.2",
    "duncan3dc/sessions": "^2.0"
  },
  "require-dev": {
    "mockery/mockery": "1.0.*",
    "phpunit/phpunit": "~8.0",
    "10up/wp_mock": "dev-master",
    "friendsofphp/php-cs-fixer": "^2.0",
    "szepeviktor/phpstan-wordpress": "^0.6.0",
    "wp-premium/gravityforms": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Yard\\DigiD\\": "./src/DigiD"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Yard\\Tests\\DigiD\\": "./tests/Unit"
    }
  },
  "scripts": {
    "unit": "clear && ./vendor/bin/phpunit --testsuite 'Unit Test Suite' --colors=always",
    "unit-coverage": "clear && ./vendor/bin/phpunit --testsuite 'Unit Test Suite' --colors=always --coverage-html ./tests/coverage",
    "integration": "clear && ./vendor/bin/phpunit --testsuite 'Integration Test Suite' --colors=always",
    "test": [
      "@unit",
      "@integration"
    ],
    "cs": "./vendor/bin/php-cs-fixer fix",
    "phpstan": "./vendor/bin/phpstan"
  }
}
